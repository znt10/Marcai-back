# WhatsApp (Evolution API). A CHAVE alimenta dois serviços: o `evolution`
# deste compose a exige como AUTHENTICATION_API_KEY e o `app` do front a manda
# como EVOLUTION_API_KEY — mesma chave, dois lados da rede `brutus`. Gerar com
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="brutus"

# Segredo do agendador de lembretes. A MESMA variável que o front usa para
# assinar a chamada a `/api/cron/lembretes` — o agendador manda o Bearer, o
# app confere. Gerar com
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
CRON_SECRET=""
