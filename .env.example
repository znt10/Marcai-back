# WhatsApp (Evolution API). A CHAVE alimenta dois serviços deste MESMO
# compose: `evolution` a exige como AUTHENTICATION_API_KEY e `api` a manda
# como EVOLUTION_API_KEY (`app/services/whatsapp.py`) — mesma chave, dois
# lados da rede `brutus`. Desde a fatia 8 o front não lê mais nenhuma das
# duas. Gerar com
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="Marcai"

# Segredo de `POST /api/cron/lembretes`. Desde a fatia 7 o disparo AGENDADO
# não passa mais por aqui — é a tarefa de beat `app.tasks.lembretes`, dentro
# do próprio `worker`, chamando o serviço direto. A rota HTTP continua
# existindo como gancho manual/externo, e ainda exige este Bearer. Gerar com
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
CRON_SECRET=""

# O dominio que o slug.py compara com o Host. Precisa ser IGUAL ao
# NEXT_PUBLIC_DOMINIO_BASE do front: se divergirem, o back resolve tenant
# para um host que o front nunca gera, e o sintoma e 404 em tudo.
DOMINIO_BASE="localhost"

# Onde o link do convite de barbeiro abre — sempre o FRONT (Next), nunca o
# Django, porque e' quem serve `/convite/[token]`. Precisa ser IGUAL a
# NEXT_PUBLIC_URL_BASE do .env do front: divergir gera um link que o outro
# lado nao serve.
URL_BASE="http://localhost:3000"

# OBRIGATÓRIA: o compose passa esta variável para `api`, `worker` e `beat` com
# `:?`, então subir sem ela falha na hora, e de propósito. settings.py:8 tem um
# padrão ("inseguro-so-em-dev") que faria o Django subir calado com chave de
# fachada. Gerar com
# `node -e "console.log(require('crypto').randomBytes(50).toString('base64url'))"`.
DJANGO_SECRET_KEY=""

# OBRIGATÓRIA, e tem que ser IDÊNTICA à `SESSAO_JWT_SECRET` do .env do front.
# Não é uma cópia por conveniência: durante a travessia o cookie de sessão do
# barbeiro é emitido por um lado e lido pelo outro (quem serve cada rota sai do
# `MIGRADAS` do client.ts), e o barbeiro não faz login de novo ao trocar de
# tela. Com segredos diferentes, todo mundo é deslogado ao atravessar — e só
# em algumas telas, que é o que torna isso caro de diagnosticar.
#
# É DIFERENTE de `ADMIN_JWT_SECRET` de propósito: um cookie de admin
# apresentado ao painel do barbeiro falha na assinatura sem que ninguém
# precise escrever uma checagem para isso.
SESSAO_JWT_SECRET=""
REDIS_URL="redis://redis:6379/1"

# Estas três NÃO alimentam o docker-compose.yml — lá `api`, `worker` e `beat`
# já têm PGHOST=db e PGPORT=5432 escritos direto no `environment:` de cada
# serviço, porque de DENTRO do contêiner é assim que se chega no `db`. Elas
# existem para rodar `manage.py` no HOST (fora de qualquer contêiner), contra
# o Postgres do compose pela porta publicada (5433). Sem elas, `manage.py
# check` morre com um `KeyError: 'PGDATABASE'` cru — settings.py lê
# `os.environ["PGDATABASE"]` sem valor padrão de propósito, para nunca
# apontar em silêncio para o banco errado. Exporte as três no shell antes de
# um `manage.py` direto no host; `pytest` não precisa, já as define sozinho
# (`brutus_test`, ver pytest.ini) e ignora o que estiver aqui.
PGDATABASE="brutus"
PGHOST="localhost"
PGPORT="5433"

# Admin da plataforma. MUDARAM DE LADO na fatia 8: eram lidas por codigo Next
# (`src/lib/admin-senha.ts`), e hoje quem le e o Django —
# `app/services/admin_senha.py` e `app/services/admin_sessao.py`. O front nao
# tem mais uma linha que as toque.
#
# Sem estas duas o login apenas NEGA (o `conferir_senha` roda o argon2 contra
# um hash descartavel e devolve False), e e assim que se sobe o back sem admin
# configurado. Gerar o hash com `python manage.py admin_hash "senha"`.
#
# O hash vai em BASE64: em claro ele e `$argon2id$v=19$m=...`, e tanto o
# Docker Compose quanto o dotenv expandem `$argon2id` e `$v` como variavel — o
# valor chegaria truncado ao processo, a senha nunca conferiria, e o sintoma
# seria um "usuario ou senha invalidos" que nao explica nada.
ADMIN_USUARIO=""
# A senha do admin, em UMA das duas formas — o hash tem precedencia:
#
#   ADMIN_SENHA           legivel, para desenvolvimento na propria maquina.
#   ADMIN_SENHA_HASH_B64  argon2id em base64, para producao. Gere com
#                         `manage.py admin_hash 'a-senha'`.
#
# Um arquivo com a senha legivel entrega a conta a quem o ler (um backup, um
# `docker inspect`, um log de ambiente); o hash nao. Por isso a de cima e' um
# atalho de dev, e o back registra um aviso se ela for usada com DEBUG=0.
ADMIN_SENHA=""
ADMIN_SENHA_HASH_B64=""

# OBRIGATORIA: `admin_sessao._segredo()` levanta RuntimeError sem ela, de
# proposito — um fallback aceitaria cookie assinado com segredo publico se
# alguem esquecesse a variavel no deploy, sem nada quebrar visivelmente.
#
# Tem que ser IDENTICA a do `.env` do front: o Django EMITE o cookie
# (`AdminLoginView`) e o `proxy.ts` do front o LE para guardar as paginas
# `/admin/*`. Divergir desloga o admin a cada navegacao.
#
# E' DIFERENTE de `SESSAO_JWT_SECRET` de proposito: um cookie de admin
# apresentado ao painel do barbeiro falha na assinatura sem que ninguem
# precise escrever uma checagem para isso. Gerar com
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
ADMIN_JWT_SECRET=""

# O banco da Evolution, que o zelador (fatia 7) le para podar historico. NAO
# alimentam o compose — o servico `evolution` monta a propria URL de conexao
# lá. Existem porque `settings.py` as le para a conexao `evolution` do Django,
# e o `pytest.ini` sobrescreve a primeira com `evolution_test` SEM prefixo
# `D:`, para que a suite nunca toque o banco da Evolution de verdade.
PGDATABASE_EVOLUTION="evolution"
PGPASSWORD_EVOLUTION="evolution"
