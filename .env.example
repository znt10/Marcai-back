# WhatsApp (Evolution API). A CHAVE alimenta dois serviços: o `evolution`
# deste compose a exige como AUTHENTICATION_API_KEY e o `app` do front a manda
# como EVOLUTION_API_KEY — mesma chave, dois lados da rede `brutus`. Gerar com
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="Marcai"

# EVOLUTION_API_URL_HOST saiu daqui. Nada NESTE repositorio a le — quem le sao
# os scripts `whatsapp:qr` e `whatsapp:estado`, que moram no front e rodam do
# host lendo o .env DE LA. Era sobra da epoca de repositorio unico, e uma
# variavel documentada no lugar errado e pior que ausente: manda a pessoa
# preencher onde nao tem efeito.

# Segredo de `POST /api/cron/lembretes`. Desde a fatia 7 o disparo AGENDADO
# não passa mais por aqui — é a tarefa de beat `app.tasks.lembretes`, dentro
# do próprio `worker`, chamando o serviço direto. A rota HTTP continua
# existindo como gancho manual/externo, e ainda exige este Bearer. Gerar com
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
CRON_SECRET=""

# O dominio que o slug.py compara com o Host. Precisa ser IGUAL ao
# NEXT_PUBLIC_DOMINIO_BASE do front: se divergirem, o back resolve tenant
# para um host que o front nunca gera, e o sintoma e 404 em tudo.
DOMINIO_BASE="localhost"

# Onde o link do convite de barbeiro abre — sempre o FRONT (Next), nunca o
# Django, porque e' quem serve `/convite/[token]`.
#
# Ja precisou casar com uma `NEXT_PUBLIC_URL_BASE` do lado de la; aquela
# variavel nao existe mais, porque quem monta o link virou o Django. Esta aqui
# e a unica fonte, e o que ela tem de acertar e o endereco onde o Next
# responde.
URL_BASE="http://localhost:3000"

# OBRIGATÓRIA: o compose passa esta variável para `api`, `worker` e `beat` com
# `:?`, então subir sem ela falha na hora, e de propósito. settings.py:8 tem um
# padrão ("inseguro-so-em-dev") que faria o Django subir calado com chave de
# fachada. Gerar com
# `node -e "console.log(require('crypto').randomBytes(50).toString('base64url'))"`.
DJANGO_SECRET_KEY=""

# OBRIGATÓRIA. Assina o cookie de sessão do BARBEIRO.
#
# Já teve de ser idêntica à do .env do front, porque durante a travessia o
# cookie era emitido por um lado e lido pelo outro, e segredos diferentes
# deslogavam todo mundo ao atravessar. A travessia acabou na fatia 4: o Next
# perdeu os segredos junto com o banco, e o `proxy.ts` de lá só olha se o
# cookie EXISTE. Quem confere assinatura, e recusa, é o Django — a cada
# requisição, que é o único lugar onde isso vale alguma coisa.
#
# Este valor agora só precisa ser igual A ELE MESMO entre reinícios: trocá-lo
# desloga todo barbeiro logado, e é para isso que serve.
SESSAO_JWT_SECRET=""

# OBRIGATÓRIA. Assina o cookie do ADMIN DA PLATAFORMA — e é OUTRO segredo de
# propósito: fosse o mesmo, vazar um vazaria os dois (spec do admin §4). De
# quebra, um cookie de admin apresentado ao painel do barbeiro falha na
# assinatura sem que ninguém precise escrever uma checagem para isso.
#
# Faltava desde a fatia 3, quando o login do admin passou a ser Django. O
# sintoma não parecia falta de configuração: a rota autenticava certo e morria
# em `emitir()` com 500, e a tela mostrava "Não deu certo. Tenta de novo?" —
# a mesma frase de senha errada. Só apareceu na travessia da fatia 5.
ADMIN_JWT_SECRET=""
REDIS_URL="redis://redis:6379/1"

# Estas três NÃO alimentam o docker-compose.yml — lá `api`, `worker` e `beat`
# já têm PGHOST=db e PGPORT=5432 escritos direto no `environment:` de cada
# serviço, porque de DENTRO do contêiner é assim que se chega no `db`. Elas
# existem para rodar `manage.py` no HOST (fora de qualquer contêiner), contra
# o Postgres do compose pela porta publicada (5433). Sem elas, `manage.py
# check` morre com um `KeyError: 'PGDATABASE'` cru — settings.py lê
# `os.environ["PGDATABASE"]` sem valor padrão de propósito, para nunca
# apontar em silêncio para o banco errado. Exporte as três no shell antes de
# um `manage.py` direto no host; `pytest` não precisa, já as define sozinho
# (`brutus_test`, ver pytest.ini) e ignora o que estiver aqui.
PGDATABASE="brutus"
PGHOST="localhost"
PGPORT="5433"

# ---------------------------------------------------------------- semente de dev
#
# Login e senha do admin que o `docker compose up` cria sozinho, junto com uma
# barbearia de demonstracao completa (dono, barbeiro, servico e expediente).
# Sem isso, todo `down -v` deixa um banco migrado e VAZIO, e a primeira tela
# util fica a uns dez minutos de cadastro manual.
#
# Vazias = os padroes do comando: `admin` / `dev12345`. Estao aqui para dar
# onde trocar sem editar codigo.
#
# Nada disso alcanca producao: `semear_dev` RECUSA rodar fora de
# DJANGO_DEBUG=1, e o compose so passa a variavel de gatilho (SEMEAR_DEV) para
# o servico `api`. Em producao o admin nasce por `manage.py criar_admin`, que
# pede a senha sem eco — sem rastro em `docker compose config`, em log de CI
# ou no historico do shell.
SEMENTE_ADMIN_LOGIN=""
SEMENTE_ADMIN_SENHA=""
