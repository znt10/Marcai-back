# WhatsApp (Evolution API). A CHAVE alimenta dois serviços: o `evolution`
# deste compose a exige como AUTHENTICATION_API_KEY e o `app` do front a manda
# como EVOLUTION_API_KEY — mesma chave, dois lados da rede `brutus`. Gerar com
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="Marcai"

# Endereço da Evolution vista do HOST. Dentro da rede do compose o nome é
# `http://evolution:8080`; aqui é localhost porque quem lê isto são os scripts
# que rodam fora de contêiner (`npm run whatsapp:qr`).
EVOLUTION_API_URL_HOST="http://localhost:8080"

# Segredo do agendador de lembretes. A MESMA variável que o front usa para
# assinar a chamada a `/api/cron/lembretes` — o agendador manda o Bearer, o
# app confere. Gerar com
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
CRON_SECRET=""

# O dominio que o slug.py compara com o Host. Precisa ser IGUAL ao
# NEXT_PUBLIC_DOMINIO_BASE do front: se divergirem, o back resolve tenant
# para um host que o front nunca gera, e o sintoma e 404 em tudo.
DOMINIO_BASE="localhost"

# Onde o link do convite de barbeiro abre — sempre o FRONT (Next), nunca o
# Django, porque e' quem serve `/convite/[token]`. Precisa ser IGUAL a
# NEXT_PUBLIC_URL_BASE do .env do front: divergir gera um link que o outro
# lado nao serve.
URL_BASE="http://localhost:3000"

# OBRIGATÓRIA: o compose passa esta variável para `api`, `worker` e `beat` com
# `:?`, então subir sem ela falha na hora, e de propósito. settings.py:8 tem um
# padrão ("inseguro-so-em-dev") que faria o Django subir calado com chave de
# fachada. Gerar com
# `node -e "console.log(require('crypto').randomBytes(50).toString('base64url'))"`.
DJANGO_SECRET_KEY=""

# OBRIGATÓRIA, e tem que ser IDÊNTICA à `SESSAO_JWT_SECRET` do .env do front.
# Não é uma cópia por conveniência: durante a travessia o cookie de sessão do
# barbeiro é emitido por um lado e lido pelo outro (quem serve cada rota sai do
# `MIGRADAS` do client.ts), e o barbeiro não faz login de novo ao trocar de
# tela. Com segredos diferentes, todo mundo é deslogado ao atravessar — e só
# em algumas telas, que é o que torna isso caro de diagnosticar.
#
# É DIFERENTE de `ADMIN_JWT_SECRET` de propósito: um cookie de admin
# apresentado ao painel do barbeiro falha na assinatura sem que ninguém
# precise escrever uma checagem para isso.
SESSAO_JWT_SECRET=""
REDIS_URL="redis://redis:6379/1"

# Estas três NÃO alimentam o docker-compose.yml — lá `api`, `worker` e `beat`
# já têm PGHOST=db e PGPORT=5432 escritos direto no `environment:` de cada
# serviço, porque de DENTRO do contêiner é assim que se chega no `db`. Elas
# existem para rodar `manage.py` no HOST (fora de qualquer contêiner), contra
# o Postgres do compose pela porta publicada (5433). Sem elas, `manage.py
# check` morre com um `KeyError: 'PGDATABASE'` cru — settings.py lê
# `os.environ["PGDATABASE"]` sem valor padrão de propósito, para nunca
# apontar em silêncio para o banco errado. Exporte as três no shell antes de
# um `manage.py` direto no host; `pytest` não precisa, já as define sozinho
# (`brutus_test`, ver pytest.ini) e ignora o que estiver aqui.
PGDATABASE="brutus"
PGHOST="localhost"
PGPORT="5433"
